# Nenhuma integração externa está ativa por padrão.
PROVIDERS_JSON=[]
WEB_ENABLED=false
BACKUPS_ENABLED=false
# Segredos em .dev.vars local ignorado ou wrangler secret put <NOME>.
# Nomes aceitos: GROQ_API_KEY, OPENROUTER_API_KEY, GENERIC_API_KEY.
# Workers AI usa binding AI; backups usam binding BACKUPS.
# Não registrar chaves neste arquivo ou no frontend.
CAPABILITIES_JSON=[]
RESEARCH_FEEDS_JSON=[]
NOTIFICATION_ALLOWED_HOSTS_JSON=[]
# Segredos opcionais: CAPABILITY_API_KEY e NOTIFICATION_SIGNING_KEY.
# Não inserir valores secretos neste arquivo. Consulte docs/CAPACIDADES.md.
