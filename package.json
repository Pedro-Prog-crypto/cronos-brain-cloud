{
  "name": "cronos-brain-cloud",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/embed-admin.mjs && wrangler dev --local --ip 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/embed-admin.mjs && esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=dist/worker.mjs",
    "test": "npm run build && tsx --test tests/*.test.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "device:create": "node scripts/device-create.mjs",
    "check": "npm run typecheck && npm test",
    "test:ui": "npm run build && node tests/ui.smoke.mjs",
    "docs:api": "node --import tsx scripts/openapi.ts",
    "benchmark": "npm run build && node scripts/benchmark.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "playwright": "1.57.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.156.0"
  }
}
